@model VolunteerSignUp
@{
    ViewData["Title"] = "Become a Volunteer";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg">
            <div class="card-body p-4">
                <h2 class="mb-4">Become a Volunteer</h2>
                <p class="text-muted mb-4">Fill out the form below to join our volunteer team. We'll get back to you soon!</p>
        
        <form asp-action="BecomeVolunteer" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="your.email@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Interests" class="form-label"></label>
                <textarea asp-for="Interests" class="form-control" rows="3" placeholder="e.g., Children's programs, website updates"></textarea>
                <small class="form-text text-muted">Please describe your areas of interest (e.g., Children's programs, website updates, community outreach)</small>
                <span asp-validation-for="Interests" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Availability" class="form-label"></label>
                <input asp-for="Availability" class="form-control" placeholder="e.g., Weekends, Weekday evenings" />
                <small class="form-text text-muted">When are you available to volunteer?</small>
                <span asp-validation-for="Availability" class="text-danger"></span>
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg flex-fill">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle me-2" viewBox="0 0 16 16" style="vertical-align: middle;">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                    </svg>
                    Submit Application
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

